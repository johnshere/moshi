{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "main.tsx",
    "access/**/*.tsx",
    "graph/**/*.ts",
    "graph/**/*.tsx",
    "state/**/*.ts",
    "table/**/*.ts",
    "table/**/*.tsx",
    "filter/**/*.ts",
    "filter/**/*.tsx",
    "inspector/**/*.ts",
    "inspector/**/*.tsx",
    "inbox/**/*.ts",
    "inbox/**/*.tsx",
    "settings/**/*.ts",
    "settings/**/*.tsx",
    "shell/**/*.ts",
    "shell/**/*.tsx",
    "vite.config.ts"
  ]
}
