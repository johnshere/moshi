{
  "name": "moshi",
  "version": "0.1.0",
  "private": true,
  "description": "默识（moshi）——本机环境状态的客户端记忆系统",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.15.1",
  "bin": {
    "moshi": "./dist/app/main.js"
  },
  "scripts": {
    "build": "pnpm build:ui && tsc -p tsconfig.build.json && node tools/copy-assets.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "build:ui": "pnpm --filter moshi-ui build",
    "dev": "tsx watch src/app/main.ts daemon",
    "start": "node dist/app/main.js daemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "pnpm --filter moshi-ui typecheck",
    "lint": "eslint src tools tests --ext .ts",
    "lint:deps": "tsx tools/lint-deps.ts",
    "lint:desc": "tsx tools/lint-descriptions.ts",
    "verify": "pnpm typecheck && pnpm typecheck:ui && pnpm lint:deps && pnpm lint:lifecycle && pnpm lint:writes && pnpm lint:archive && pnpm test",
    "lint:lifecycle": "tsx tools/check-lifecycle.ts",
    "lint:writes": "tsx tools/check-writes.ts",
    "lint:archive": "tsx tools/check-archive.ts",
    "check:visual": "tsx tools/check-visual.ts",
    "accept:p2": "tsx tools/accept-p2.ts",
    "accept:ui": "tsx tools/accept-ui.ts",
    "bench": "tsx tools/bench.ts",
    "train:gat": "node scripts/train-gat.mjs",
    "check:gat": "tsx tools/gat-shadow-check.ts",
    "seed:devdb": "tsx tools/seed-devdb.ts",
    "dev:reset": "tsx tools/dev-db.ts",
    "setup:env": "node scripts/setup-env.mjs --force",
    "postinstall": "node scripts/setup-env.mjs --hook"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "better-sqlite3": "^12.2.0",
    "d3-force-3d": "3.0.6",
    "fastify": "^5.6.1",
    "pino": "^9.13.1",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.9",
    "eslint": "^9.38.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  }
}
