node_modules/
dist/
# 前端（src/ui）的构建产物：由 `pnpm build:ui` 生成，不入库
src/app/ui/dist/
coverage/
*.log
.DS_Store
.dsh/
.claude/
.workbuddy-ai/
# 测试用临时目录
.tmp/
.tmp-smoke/
# 构建/验证时的工程内 TEMP 重定向（AGENTS.md DoD 要求，产物不落系统 temp）
temp/
# Python 缓存（sidecar）
__pycache__/
*.pyc
# sidecar 虚拟环境与模型权重（体积大、可复现，见 sidecar/requirements.txt 与 fetch_model.py）
sidecar/.venv/
sidecar/models/
# 训练产物（`pnpm train:gat` 生成，可由样本复现；运行时权重在 <data_dir>/models/）
models/
